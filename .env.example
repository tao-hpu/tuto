# Cito (scholar search engine) API access, used by L1 verify and the triage funnel.
# Copy to .env and fill in. Never commit .env.
CITO_API_BASE=https://api.cito.fim.ai
CITO_API_KEY=your-key-here

# OpenAI-compatible chat endpoint for L1 residual judge + L2 support/arbiter.
# /check and the L2 pipeline refuse to start without these.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
L2_MODEL=gpt-6-luna
L1_JUDGE_MODEL=gpt-6-luna
L2_ARBITER_MODEL=gpt-6-luna
